{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug app",
      "program": "${workspaceFolder}/scripts/develop.mjs",
      "runtimeArgs": ["--disable-warning=MODULE_TYPELESS_PACKAGE_JSON"],
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "outFiles": ["${workspaceFolder}/out/*.js"],
      "console": "internalConsole"
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to renderer",
      // Must match RENDERER_REMOTE_DEBUGGING_PORT in src/node/debug-ports.ts
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/ui",
      "timeout": 60000
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to daemon",
      // Must match SERVER_INSPECTOR_PORT in src/node/debug-ports.ts
      "port": 9229,
      "restart": true,
      "outFiles": ["${workspaceFolder}/out/*.js"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI",
      "osx": {
        "runtimeExecutable": "${workspaceFolder}/scripts/cli_darwin.sh"
      },
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/scripts/cli.bat"
      },
      "linux": {
        "runtimeExecutable": "${workspaceFolder}/scripts/cli.sh"
      },
      "autoAttachChildProcesses": true,
      "outFiles": ["${workspaceFolder}/out/*.js"],
      "console": "internalConsole",
      "args": "${input:cliArgs}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current test file",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "smartStep": true,
      "console": "internalConsole"
    },
    {
      "type": "cppvsdbg",
      "request": "attach",
      "name": "Attach to CS2 plugin (Windows)",
      "processId": "${command:pickProcess}"
    },
    {
      "type": "cppdbg",
      "request": "attach",
      "name": "Attach to CS2 plugin (Linux)",
      "program": "${input:cs2LinuxExecutable}",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug app + renderer",
      "configurations": ["Debug app", "Attach to renderer"],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "cliArgs",
      "type": "promptString",
      "description": "CLI arguments",
      "default": "analyze"
    },
    {
      "id": "cs2LinuxExecutable",
      "type": "promptString",
      "description": "Path to the cs2 executable",
      "default": "${env:HOME}/.steam/steam/steamapps/common/Counter-Strike Global Offensive/game/bin/linuxsteamrt64/cs2"
    }
  ]
}
